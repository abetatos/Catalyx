{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\" pre-edit"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\" post-edit"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\" post-bash"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read(catalyx/config/**)",
      "Read(schemas/**)",
      "Read(data/**)",
      "Write(data/catalysts/**)",
      "Write(data/snapshots/**)",
      "Write(data/movements/**)",
      "Write(data/sector_studies/**)",
      "Bash(bash scripts/post_run.sh)"
    ]
  }
}