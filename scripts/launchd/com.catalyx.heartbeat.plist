<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.catalyx.heartbeat</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/heartbeat.sh</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <!-- Tue + Fri 08:12 local: after the prior day's US close is fully in yfinance, before the
       Europe open. Off the :00 mark on purpose. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>12</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>12</integer></dict>
  </array>
  <key>StandardOutPath</key><string>__REPO__/data/reports/heartbeat_launchd.out</string>
  <key>StandardErrorPath</key><string>__REPO__/data/reports/heartbeat_launchd.err</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
